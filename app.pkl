### ml_models/training_notebooks/train_models.ipynb

# This is a Python script version of the notebook
# You can convert it back to .ipynb using Jupyter or run as a script

import pandas as pd
from sklearn.metrics.pairwise import cosine_similarity
from sklearn.feature_extraction.text import TfidfVectorizer
import pickle

# Load data
df_users = pd.read_csv('../../data/user_interactions.csv')
df_products = pd.read_csv('../../data/products.csv')

# --- Collaborative Filtering ---
# Create user-product matrix
user_product_matrix = df_users.pivot_table(index='user_id', columns='product_id', values='interaction', fill_value=0)

# Compute similarity matrix
user_sim = cosine_similarity(user_product_matrix)
user_sim_df = pd.DataFrame(user_sim, index=user_product_matrix.index, columns=user_product_matrix.index)

# Get top N recommendations for each user
user_recommendations = {}
for user in user_sim_df.index:
    similar_users = user_sim_df[user].sort_values(ascending=False).index[1:6]
    recommended_products = df_users[df_users['user_id'].isin(similar_users)]['product_id'].value_counts().head(5).index.tolist()
    user_recommendations[user] = recommended_products

# Save collaborative filtering model
with open('../collaborative_model.pkl', 'wb') as f:
    pickle.dump(user_recommendations, f)

# --- Content-Based Filtering ---
# Use TF-IDF on product descriptions
tfidf = TfidfVectorizer(stop_words='english')
tfidf_matrix = tfidf.fit_transform(df_products['description'].fillna(''))

# Compute similarity matrix
product_sim = cosine_similarity(tfidf_matrix)
product_sim_df = pd.DataFrame(product_sim, index=df_products['product_id'], columns=df_products['product_id'])

# Get top N similar products
product_recommendations = {}
for pid in product_sim_df.index:
    similar_products = product_sim_df[pid].sort_values(ascending=False).index[1:6].tolist()
    product_recommendations[pid] = similar_products

# Save content-based model
with open('../content_based_model.pkl', 'wb') as f:
    pickle.dump(product_recommendations, f)

print("✅ Models trained and saved!")
